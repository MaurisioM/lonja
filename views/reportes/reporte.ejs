<%- include('../plantillas/header') %>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 d-print-none">
  <h1 class="h3 mb-0">Reportes de compras</h1>
  <button class="btn btn-success" type="button" onclick="window.print()">Imprimir / PDF</button>
</div>

<%# el reporte se puede generar de un solo día o de un rango de fechas %>
<div class="card mb-4 d-print-none">
  <div class="card-body">
    <ul class="nav nav-pills mb-3">
      <li class="nav-item"><a class="nav-link <%= modo === 'dia' ? 'active' : '' %>" href="/reportes?modo=dia&fecha=<%= hasta %>">Por día</a></li>
      <li class="nav-item"><a class="nav-link <%= modo === 'rango' ? 'active' : '' %>" href="/reportes?modo=rango&desde=<%= desde %>&hasta=<%= hasta %>">Por rango de fechas</a></li>
    </ul>
    <form class="row g-2 align-items-end" method="GET" action="/reportes">
      <input type="hidden" name="modo" value="<%= modo %>">
      <% if (modo === 'dia') { %>
        <div class="col-sm-auto">
          <label class="form-label mb-1" for="fecha">Fecha</label>
          <input type="date" class="form-control" id="fecha" name="fecha" value="<%= desde %>" required>
        </div>
      <% } else { %>
        <div class="col-sm-auto">
          <label class="form-label mb-1" for="desde">Desde</label>
          <input type="date" class="form-control" id="desde" name="desde" value="<%= desde %>" required>
        </div>
        <div class="col-sm-auto">
          <label class="form-label mb-1" for="hasta">Hasta</label>
          <input type="date" class="form-control" id="hasta" name="hasta" value="<%= hasta %>" required>
        </div>
      <% } %>
      <div class="col-sm-auto">
        <button class="btn btn-primary" type="submit">Generar reporte</button>
      </div>
    </form>
  </div>
</div>

<div class="text-center mb-4">
  <img src="/bootstrap/img/lonja.svg" width="56" height="56" alt="" class="d-none d-print-inline">
  <h2 class="h4 mb-0">Lonja de Veracruz</h2>
  <p class="mb-0">
    <%= unDia ? 'Informe diario de compras ·' : 'Informe de compras' %>
    <strong class="<%= unDia ? 'text-capitalize' : '' %>"><%= periodo %></strong>
  </p>
  <p class="small text-muted">Generado el <%= generado %> por <%= usuario.nombre %> <%= usuario.apellido %></p>
</div>

<div class="row g-3 mb-4 text-center">
  <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="small text-muted">Compras</div><div class="fs-4 fw-bold"><%= compras.length %></div></div></div>
  <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="small text-muted">Kilos</div><div class="fs-4 fw-bold"><%= totales.kilos.toFixed(2) %></div></div></div>
  <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="small text-muted">Cajas</div><div class="fs-4 fw-bold"><%= totales.cajas %></div></div></div>
  <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="small text-muted">Importe total</div><div class="fs-4 fw-bold"><%= dinero(totales.importe) %></div></div></div>
</div>

<% if (!unDia && porDia.length) { %>
  <h3 class="h5">Resumen por día</h3>
  <table class="table table-sm table-bordered" style="max-width: 720px">
    <thead class="table-light">
      <tr><th>Día</th><th class="text-end">Compras</th><th class="text-end">Kilos</th><th class="text-end">Cajas</th><th class="text-end">Importe</th></tr>
    </thead>
    <tbody>
      <% porDia.forEach(d => { %>
        <tr>
          <td>
            <a class="text-decoration-none" href="/reportes?modo=dia&fecha=<%= d.dia %>"><%= d.texto %></a>
          </td>
          <td class="text-end"><%= d.lotes %></td>
          <td class="text-end"><%= d.kilos.toFixed(2) %></td>
          <td class="text-end"><%= d.cajas %></td>
          <td class="text-end"><%= dinero(d.importe) %></td>
        </tr>
      <% }) %>
    </tbody>
    <tfoot class="table-light fw-bold">
      <tr>
        <td class="text-end">Totales</td>
        <td class="text-end"><%= totales.lotes %></td>
        <td class="text-end"><%= totales.kilos.toFixed(2) %></td>
        <td class="text-end"><%= totales.cajas %></td>
        <td class="text-end"><%= dinero(totales.importe) %></td>
      </tr>
    </tfoot>
  </table>
<% } %>

<h3 class="h5 <%= unDia ? '' : 'mt-4' %>">Detalle de compras</h3>
<div class="table-responsive">
<table class="table table-sm table-bordered align-middle">
  <thead class="table-light">
    <tr>
      <th><%= unDia ? 'Hora' : 'Fecha y hora' %></th><th>Lote</th><th>Comprador</th><th>Origen</th><th>Especies (tipo)</th>
      <th class="text-end">Kilos</th><th class="text-end">Cajas</th>
      <th class="text-end">Salida / kg</th><th class="text-end">Final / kg</th><th class="text-end">Total</th>
    </tr>
  </thead>
  <tbody>
    <% compras.forEach(c => { %>
      <tr>
        <td class="text-nowrap">
          <%= unDia ? new Date(c.fecha).toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' }) : mostrarFecha(c.fecha) %>
        </td>
        <td><%= c.id_cmp %></td>
        <td>
          <%= c.comprador.codigo_cpr %> · <%= c.comprador.nombre %> <%= c.comprador.apellido_paterno %> <%= c.comprador.apellido_materno || '' %>
        </td>
        <td>
          <% if (c.id_pgo) { %>En línea<% if (c.pago) { %> <span class="text-muted small">(<%= c.pago.referencia %>)</span><% } %>
          <% } else { %>Mostrador<% } %>
        </td>
        <td>
          <% c.lote.especies.forEach(e => { %>
            <div class="d-flex align-items-center gap-1">
              <% if (e.imagen) { %><img src="/img/especies/<%= e.imagen %>" alt="" class="mini-reporte rounded"><% } %>
              <%= e.nombre %> <span class="text-muted small">(<%= e.tipo.nombre %>)</span>
            </div>
          <% }) %>
          <% if (!c.lote.especies.length) { %>—<% } %>
        </td>
        <td class="text-end"><%= Number(c.lote.kilos).toFixed(2) %></td>
        <td class="text-end"><%= c.lote.numero_cajas %></td>
        <td class="text-end"><%= dinero(c.lote.precio_kilo_salida) %></td>
        <td class="text-end"><%= dinero(c.precio_kilo_final) %></td>
        <td class="text-end fw-semibold"><%= dinero(c.precio_total) %></td>
      </tr>
    <% }) %>
    <% if (!compras.length) { %>
      <tr><td colspan="10" class="text-center text-muted py-3">No hubo compras en <%= unDia ? 'esta fecha' : 'este rango de fechas' %></td></tr>
    <% } %>
  </tbody>
  <% if (compras.length) { %>
    <tfoot class="table-light fw-bold">
      <tr>
        <td colspan="5" class="text-end">Totales</td>
        <td class="text-end"><%= totales.kilos.toFixed(2) %></td>
        <td class="text-end"><%= totales.cajas %></td>
        <td colspan="2"></td>
        <td class="text-end"><%= dinero(totales.importe) %></td>
      </tr>
    </tfoot>
  <% } %>
</table>
</div>

<% if (porComprador.length) { %>
  <h3 class="h5 mt-4">Resumen por comprador</h3>
  <table class="table table-sm table-bordered" style="max-width: 720px">
    <thead class="table-light">
      <tr><th>Comprador</th><th class="text-end">Lotes</th><th class="text-end">Kilos</th><th class="text-end">Importe</th></tr>
    </thead>
    <tbody>
      <% porComprador.forEach(p => { %>
        <tr>
          <td><%= p.nombre %></td>
          <td class="text-end"><%= p.lotes %></td>
          <td class="text-end"><%= p.kilos.toFixed(2) %></td>
          <td class="text-end"><%= dinero(p.importe) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>
<%- include('../plantillas/footer') %>
