<%- include('../plantillas/header') %>
<% const editando = persona && persona.id; %>
<h1 class="h3 mb-3"><%= editando ? 'Editar' : 'Nuevo' %> usuario</h1>
<%- include('../plantillas/errores') %>

<form action="<%= action %>" method="<%= method %>" class="row g-3" style="max-width: 720px">
  <div class="col-md-6">
    <label class="form-label" for="usuario">Nombre de usuario</label>
    <input class="form-control" id="usuario" name="usuario" maxlength="30" value="<%= persona ? persona.usuario : '' %>" required>
  </div>
  <div class="col-md-6">
    <label class="form-label" for="rol">Rol</label>
    <select class="form-select" id="rol" name="rol">
      <option value="usuario" <%= persona && persona.rol === 'usuario' ? 'selected' : '' %>>Usuario (captura y reportes)</option>
      <option value="admin" <%= persona && persona.rol === 'admin' ? 'selected' : '' %>>Administrador</option>
    </select>
  </div>
  <div class="col-md-6">
    <label class="form-label" for="nombre">Nombre</label>
    <input class="form-control" id="nombre" name="nombre" maxlength="40" value="<%= persona ? persona.nombre : '' %>" required>
  </div>
  <div class="col-md-6">
    <label class="form-label" for="apellido">Apellido</label>
    <input class="form-control" id="apellido" name="apellido" maxlength="40" value="<%= persona ? persona.apellido : '' %>" required>
  </div>
  <div class="col-md-6">
    <label class="form-label" for="email">Correo</label>
    <input type="email" class="form-control" id="email" name="email" maxlength="80" value="<%= persona ? persona.email : '' %>" required>
  </div>
  <div class="col-md-6">
    <label class="form-label" for="password">Password</label>
    <input type="password" class="form-control" id="password" name="password" minlength="6" <%= editando ? '' : 'required' %>>
    <% if (editando) { %><div class="form-text">Déjalo vacío para no cambiarlo.</div><% } %>
  </div>
  <div class="col-12">
    <button class="btn btn-primary" type="submit">Guardar</button>
    <a class="btn btn-outline-secondary" href="/usuarios/ver">Cancelar</a>
  </div>
</form>
<%- include('../plantillas/footer') %>
