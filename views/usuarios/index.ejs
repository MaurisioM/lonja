<%- include('../plantillas/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Usuarios del sistema</h1>
  <a class="btn btn-primary" href="/usuarios/crear">Nuevo usuario</a>
</div>
<div class="table-responsive">
<table class="table table-striped align-middle">
  <thead class="table-dark">
    <tr><th>ID</th><th>Usuario</th><th>Nombre</th><th>Correo</th><th>Rol</th><th>Cuenta</th><th>Acciones</th></tr>
  </thead>
  <tbody>
    <% usuarios.forEach(u => { %>
      <tr>
        <td><%= u.id %></td>
        <td><%= u.usuario %></td>
        <td><%= u.nombre %> <%= u.apellido %></td>
        <td><%= u.email %></td>
        <td><span class="badge <%= u.rol === 'admin' ? 'text-bg-danger' : 'text-bg-secondary' %>"><%= u.rol %></span></td>
        <td>
          <% if (u.confirmar) { %><span class="badge text-bg-success">Activa</span>
          <% } else { %><span class="badge text-bg-warning">Sin confirmar</span><% } %>
        </td>
        <td class="text-nowrap">
          <a class="btn btn-sm btn-outline-primary" href="/usuarios/<%= u.id %>/editar">Editar</a>
          <% if (u.id !== usuario.id) { %>
            <form action="/usuarios/<%= u.id %>/confirmar?_method=PATCH" method="POST" class="d-inline">
              <button class="btn btn-sm btn-outline-secondary" type="submit"><%= u.confirmar ? 'Desactivar' : 'Activar' %></button>
            </form>
            <%- include('../plantillas/eliminar', { url: '/usuarios/' + u.id, pregunta: '¿Eliminar este usuario?' }) %>
          <% } %>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
</div>
<%- include('../plantillas/footer') %>
