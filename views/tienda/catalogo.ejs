<%- include('../plantillas/tienda_header') %>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <div>
    <h1 class="h3 mb-0">Lotes en venta</h1>
    <p class="text-muted mb-0">Cada lote se vende completo. Al agregarlo a tu carrito queda apartado para ti <%= minutos %> minutos.</p>
  </div>
  <a class="btn btn-primary" href="/tienda/carrito">Ver mi carrito (<span id="contador-carrito-2"><%= enCarrito %></span>)</a>
</div>

<div class="row g-3">
  <% lotes.forEach(({ lote: l, estado }) => { %>
    <% const foto = l.especies.find(e => e.imagen); %>
    <div class="col-sm-6 col-lg-4">
      <div class="card h-100 tarjeta-lote" data-lote="<%= l.id_lte %>" data-estado="<%= estado %>">
        <img class="card-img-top foto-lote" alt=""
          src="<%= foto ? '/img/especies/' + foto.imagen : '/bootstrap/img/lonja.svg' %>">
        <div class="card-body d-flex flex-column">
          <div class="d-flex justify-content-between align-items-start gap-2">
            <h2 class="h5 card-title mb-1">Lote <%= l.id_lte %></h2>
            <span class="badge text-bg-success insignia-disponible">Disponible</span>
            <span class="badge text-bg-primary insignia-mio">En tu carrito</span>
            <span class="badge text-bg-secondary insignia-apartado">No disponible</span>
            <span class="badge text-bg-dark insignia-vendido">Vendido</span>
          </div>
          <p class="card-text mb-2">
            <% if (l.especies.length) { %>
              <%= l.especies.map(e => e.nombre + ' (' + e.tipo.nombre + ')').join(', ') %>
            <% } else { %>
              <span class="text-muted">Sin especies registradas</span>
            <% } %>
          </p>
          <ul class="list-unstyled small text-muted mb-3">
            <li><%= Number(l.kilos).toFixed(2) %> kg · <%= l.numero_cajas %> cajas</li>
            <li><%= dinero(l.precio_kilo_salida) %> por kilo</li>
            <li>Registrado el <%= mostrarFecha(l.fecha) %></li>
          </ul>
          <div class="mt-auto">
            <div class="fs-4 fw-bold mb-2"><%= dinero(totalLote(l)) %></div>
            <form class="accion-disponible" action="/tienda/carrito/<%= l.id_lte %>" method="POST">
              <button class="btn btn-primary w-100" type="submit">Agregar al carrito</button>
            </form>
            <div class="accion-mio">
              <div class="d-flex gap-2">
                <a class="btn btn-success flex-fill" href="/tienda/carrito">Ir al carrito</a>
                <form action="/tienda/carrito/<%= l.id_lte %>?_method=DELETE&desde=catalogo" method="POST">
                  <button class="btn btn-outline-danger" type="submit">Quitar</button>
                </form>
              </div>
            </div>
            <div class="accion-apartado">
              <button class="btn btn-secondary w-100" type="button" disabled>No disponible</button>
              <div class="form-text">Otro comprador lo tiene en su carrito.</div>
            </div>
            <div class="accion-vendido">
              <button class="btn btn-dark w-100" type="button" disabled>Vendido</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% }) %>
  <% if (!lotes.length) { %>
    <div class="col-12"><p class="text-center text-muted py-5 mb-0">Por ahora no hay lotes en venta.</p></div>
  <% } %>
</div>

<script>
  // Consulta el estado de los lotes cada 10 segundos para marcar "No disponible"
  // lo que otros compradores agregan a su carrito, sin recargar la página.
  (function () {
    const tarjetas = document.querySelectorAll(".tarjeta-lote");
    if (!tarjetas.length) return;
    async function actualizar() {
      try {
        const r = await fetch("/tienda/estado", { headers: { Accept: "application/json" } });
        if (!r.ok || !(r.headers.get("content-type") || "").includes("json")) return;
        const e = await r.json();
        tarjetas.forEach((t) => {
          const id = Number(t.dataset.lote);
          t.dataset.estado = !e.enVenta.includes(id) ? "vendido"
            : e.mios.includes(id) ? "mio"
            : e.apartados.includes(id) ? "apartado"
            : "disponible";
        });
        document.querySelectorAll("#contador-carrito, #contador-carrito-2")
          .forEach((c) => { c.textContent = e.mios.length; });
      } catch (err) { /* sin conexión: se reintenta en la siguiente vuelta */ }
    }
    setInterval(actualizar, 10000);
    document.addEventListener("visibilitychange", () => { if (!document.hidden) actualizar(); });
  })();
</script>
<%- include('../plantillas/footer') %>
