<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sistema Lonja de Veracruz</title>
  <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/estilos.css">
</head>
<body class="bg-light">
  <nav class="navbar navbar-expand-lg navbar-dark bg-lonja d-print-none">
    <div class="container-fluid">
      <a class="navbar-brand d-flex align-items-center gap-2" href="/inicio">
        <img src="/bootstrap/img/lonja.svg" width="34" height="34" alt="">
        Lonja de Veracruz
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"
        aria-controls="menu" aria-expanded="false" aria-label="Menú">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="menu">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Compras</a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="/compras/crear">Registrar compra</a></li>
              <li><a class="dropdown-item" href="/compras/ver">Lista de compras</a></li>
            </ul>
          </li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Lotes</a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="/lotes/crear">Nuevo lote</a></li>
              <li><a class="dropdown-item" href="/lotes/ver">Lista de lotes</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="/especies/crear">Nueva especie</a></li>
              <li><a class="dropdown-item" href="/especies/ver">Lista de especies</a></li>
            </ul>
          </li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Catálogos</a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="/compradores/ver">Compradores</a></li>
              <li><a class="dropdown-item" href="/tipos/ver">Tipos de especie</a></li>
            </ul>
          </li>
          <li class="nav-item"><a class="nav-link" href="/reportes">Reportes</a></li>
          <% if (usuario && usuario.rol === 'admin') { %>
            <li class="nav-item"><a class="nav-link" href="/usuarios/ver">Usuarios</a></li>
          <% } %>
        </ul>
        <% if (usuario) { %>
          <span class="navbar-text me-3">
            <%= usuario.nombre %> <span class="badge text-bg-light"><%= usuario.rol %></span>
          </span>
        <% } %>
        <a class="btn btn-outline-light btn-sm" href="/cerrarsesion">Cerrar sesión</a>
      </div>
    </div>
  </nav>
  <main class="container bg-white shadow-sm p-4 my-4 rounded">
    <% if (ok) { %>
      <div class="alert alert-success alert-dismissible fade show d-print-none" role="alert">
        <%= ok %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
      </div>
    <% } %>
    <% if (aviso) { %>
      <div class="alert alert-warning alert-dismissible fade show d-print-none" role="alert">
        <%= aviso %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
      </div>
    <% } %>
