<%- include('../plantillas/header') %>
<h1 class="h3 mb-3"><%= tipo && tipo.id_tpo ? 'Editar' : 'Nuevo' %> tipo</h1>
<%- include('../plantillas/errores') %>
<form action="<%= action %>" method="<%= method %>" style="max-width: 480px">
  <div class="mb-3">
    <label class="form-label" for="nombre">Nombre</label>
    <input class="form-control" id="nombre" name="nombre" maxlength="30" value="<%= tipo ? tipo.nombre : '' %>" required autofocus>
  </div>
  <button class="btn btn-primary" type="submit">Guardar</button>
  <a class="btn btn-outline-secondary" href="/tipos/ver">Cancelar</a>
</form>
<%- include('../plantillas/footer') %>
