<%- include('../plantillas/header') %>
<% const c = comprador || {}; %>
<h1 class="h3 mb-3"><%= c.codigo_cpr ? 'Editar' : 'Nuevo' %> comprador</h1>
<%- include('../plantillas/errores') %>
<form action="<%= action %>" method="<%= method %>" class="row g-3" style="max-width: 720px">
  <div class="col-md-4">
    <label class="form-label" for="nombre">Nombre</label>
    <input class="form-control" id="nombre" name="nombre" maxlength="15" value="<%= c.nombre || '' %>" required>
  </div>
  <div class="col-md-4">
    <label class="form-label" for="apellido_paterno">Apellido paterno</label>
    <input class="form-control" id="apellido_paterno" name="apellido_paterno" maxlength="15" value="<%= c.apellido_paterno || '' %>" required>
  </div>
  <div class="col-md-4">
    <label class="form-label" for="apellido_materno">Apellido materno</label>
    <input class="form-control" id="apellido_materno" name="apellido_materno" maxlength="15" value="<%= c.apellido_materno || '' %>">
  </div>
  <div class="col-12">
    <label class="form-label" for="direccion">Dirección</label>
    <input class="form-control" id="direccion" name="direccion" maxlength="200" value="<%= c.direccion || '' %>" required>
  </div>
  <div class="col-md-8">
    <label class="form-label" for="correo">Correo</label>
    <input type="email" class="form-control" id="correo" name="correo" maxlength="80" value="<%= c.correo || '' %>" required>
  </div>
  <div class="col-12">
    <button class="btn btn-primary" type="submit">Guardar</button>
    <a class="btn btn-outline-secondary" href="/compradores/ver">Cancelar</a>
  </div>
</form>
<%- include('../plantillas/footer') %>
