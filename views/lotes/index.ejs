<%- include('../plantillas/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Lotes</h1>
  <a class="btn btn-primary" href="/lotes/crear">Nuevo lote</a>
</div>
<div class="table-responsive">
<table class="table table-striped align-middle">
  <thead class="table-dark">
    <tr>
      <th>Lote</th><th>Fecha</th><th>Especies</th><th class="text-end">Kilos</th><th class="text-end">Cajas</th>
      <th class="text-end">Precio salida / kg</th><th>Estado</th><th>Acciones</th>
    </tr>
  </thead>
  <tbody>
    <% lotes.forEach(l => { %>
      <tr>
        <td><%= l.id_lte %></td>
        <td><%= new Date(l.fecha).toLocaleString('es-MX', { dateStyle: 'short', timeStyle: 'short' }) %></td>
        <td>
          <% if (l.especies.length) { %>
            <%= l.especies.map(e => e.nombre + ' (' + e.tipo.nombre + ')').join(', ') %>
          <% } else { %>
            <a class="small" href="/especies/crear?lote=<%= l.id_lte %>">+ agregar especies</a>
          <% } %>
        </td>
        <td class="text-end"><%= Number(l.kilos).toFixed(2) %></td>
        <td class="text-end"><%= l.numero_cajas %></td>
        <td class="text-end">$<%= Number(l.precio_kilo_salida).toFixed(2) %></td>
        <td>
          <% if (l.compra) { %><span class="badge text-bg-success">Vendido</span>
          <% } else { %><a class="badge text-bg-warning text-decoration-none" href="/compras/crear?lote=<%= l.id_lte %>">Disponible · vender</a><% } %>
        </td>
        <td class="text-nowrap">
          <a class="btn btn-sm btn-outline-primary" href="/lotes/<%= l.id_lte %>/editar">Editar</a>
          <%- include('../plantillas/eliminar', { url: '/lotes/' + l.id_lte, pregunta: '¿Eliminar este lote y sus especies?' }) %>
        </td>
      </tr>
    <% }) %>
    <% if (!lotes.length) { %><tr><td colspan="8" class="text-center text-muted">No hay lotes registrados</td></tr><% } %>
  </tbody>
</table>
</div>
<%- include('../plantillas/footer') %>
