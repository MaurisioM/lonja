<%- include('../plantillas/simple_header') %>
<h1 class="h4 text-center mb-3">Registro de personal</h1>
<%- include('../plantillas/errores') %>

<form action="<%= action %>" method="<%= method %>">
  <div class="mb-3">
    <label class="form-label" for="usuario">Nombre de usuario</label>
    <input type="text" class="form-control" id="usuario" name="usuario" maxlength="30" value="<%= persona ? persona.usuario : '' %>" required>
  </div>
  <div class="row">
    <div class="col-sm-6 mb-3">
      <label class="form-label" for="nombre">Nombre</label>
      <input type="text" class="form-control" id="nombre" name="nombre" maxlength="40" value="<%= persona ? persona.nombre : '' %>" required>
    </div>
    <div class="col-sm-6 mb-3">
      <label class="form-label" for="apellido">Apellido</label>
      <input type="text" class="form-control" id="apellido" name="apellido" maxlength="40" value="<%= persona ? persona.apellido : '' %>" required>
    </div>
  </div>
  <div class="mb-3">
    <label class="form-label" for="email">Correo</label>
    <input type="email" class="form-control" id="email" name="email" maxlength="80" value="<%= persona ? persona.email : '' %>" required>
  </div>
  <div class="row">
    <div class="col-sm-6 mb-3">
      <label class="form-label" for="password">Password</label>
      <input type="password" class="form-control" id="password" name="password" minlength="6" required>
    </div>
    <div class="col-sm-6 mb-3">
      <label class="form-label" for="repetir">Repetir password</label>
      <input type="password" class="form-control" id="repetir" name="repetir" minlength="6" required>
    </div>
  </div>
  <div class="d-grid gap-2">
    <button class="btn btn-primary" type="submit">Registrarme</button>
    <a class="btn btn-outline-secondary" href="/">Cancelar</a>
  </div>
</form>
<%- include('../plantillas/simple_footer') %>
